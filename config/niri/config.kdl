// Niri chooses display modes, placement and scale automatically.
input {
    keyboard {
        xkb {
            layout "us,ara"
            options "grp:alt_shift_toggle"
        }
    }

    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 16

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        on

        width 1
    }

    border { off; }

    shadow {
        on

        softness 30

        spread 5

        offset x=0 y=5

        color "#0009"
    }
}

spawn-at-startup "sh" "-c" "exec python3 \"$HOME/.local/bin/noctalia-start.py\""

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

environment {
    GTK_CSD "0"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
}
cursor { xcursor-size 24; }

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

blur {
    passes 3
    offset 5
    noise 0.02
    saturation 1.0
}

window-rule {
    open-floating false
    opacity 0.95
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="(?i)zen"
    geometry-corner-radius 0
    clip-to-geometry true
    draw-border-with-background false
    focus-ring {
        on
        width 1
    }
}

binds {
    // #"Hardware Controls"
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Increase Speaker Volume" { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Decrease Speaker Volume" { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true repeat=false hotkey-overlay-title="Mute/Unmute Speakers" { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true repeat=false hotkey-overlay-title="Mute/Unmute Microphone" { spawn "noctalia" "msg" "mic-mute"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Increase Screen Brightness" { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Decrease Screen Brightness" { spawn "noctalia" "msg" "brightness-down"; }

    // #"Applications"
    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "alacritty"; }
    Mod+Space hotkey-overlay-title="Open Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Z hotkey-overlay-title="Open Settings" { spawn "noctalia" "msg" "settings-open"; }
    Mod+N hotkey-overlay-title="Open File Manager" { spawn "nautilus"; }
    Mod+B hotkey-overlay-title="Open Browser" { spawn "zen-browser"; }
    Mod+K hotkey-overlay-title="Open Keybind Cheatsheet" { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }
    Print hotkey-overlay-title="Screenshot" { spawn "noctalia" "msg" "screenshot-region"; }

    // #"Move Windows"
    Mod+Ctrl+Left hotkey-overlay-title="Move Column Left" { move-column-left; }
    Mod+Ctrl+Right hotkey-overlay-title="Move Column Right" { move-column-right; }
    Mod+Ctrl+Up hotkey-overlay-title="Move Window Or Workspace Up" { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Down hotkey-overlay-title="Move Window Or Workspace Down" { move-window-down-or-to-workspace-down; }

    // #"Navigation"
    Mod+Left hotkey-overlay-title="Focus Column Left" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Focus Column Right" { focus-column-right; }
    Mod+Up hotkey-overlay-title="Focus Window Or Workspace Up" { focus-window-or-workspace-up; }
    Mod+Down hotkey-overlay-title="Focus Window Or Workspace Down" { focus-window-or-workspace-down; }

    // #"Window Actions"
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+W repeat=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+V hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+F hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+Ctrl+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+C hotkey-overlay-title="Center Column" { center-column; }

    // #"Workspace Shortcuts"
    Mod+1 hotkey-overlay-title="Workspace 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="Workspace 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="Workspace 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="Workspace 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="Workspace 5" { focus-workspace 5; }
    Mod+6 hotkey-overlay-title="Workspace 6" { focus-workspace 6; }
    Mod+7 hotkey-overlay-title="Workspace 7" { focus-workspace 7; }
    Mod+8 hotkey-overlay-title="Workspace 8" { focus-workspace 8; }
    Mod+9 hotkey-overlay-title="Workspace 9" { focus-workspace 9; }
    Mod+Ctrl+1 hotkey-overlay-title="Move Column To Workspace 1" { move-column-to-workspace 1; }
    Mod+Ctrl+2 hotkey-overlay-title="Move Column To Workspace 2" { move-column-to-workspace 2; }
    Mod+Ctrl+3 hotkey-overlay-title="Move Column To Workspace 3" { move-column-to-workspace 3; }
    Mod+Ctrl+4 hotkey-overlay-title="Move Column To Workspace 4" { move-column-to-workspace 4; }
    Mod+Ctrl+5 hotkey-overlay-title="Move Column To Workspace 5" { move-column-to-workspace 5; }
    Mod+Ctrl+6 hotkey-overlay-title="Move Column To Workspace 6" { move-column-to-workspace 6; }
    Mod+Ctrl+7 hotkey-overlay-title="Move Column To Workspace 7" { move-column-to-workspace 7; }
    Mod+Ctrl+8 hotkey-overlay-title="Move Column To Workspace 8" { move-column-to-workspace 8; }
    Mod+Ctrl+9 hotkey-overlay-title="Move Column To Workspace 9" { move-column-to-workspace 9; }

    Mod+Ctrl+Alt+1 hotkey-overlay-title="Move Column Silently To Workspace 1" { move-column-to-workspace focus=false 1; }
    Mod+Ctrl+Alt+2 hotkey-overlay-title="Move Column Silently To Workspace 2" { move-column-to-workspace focus=false 2; }
    Mod+Ctrl+Alt+3 hotkey-overlay-title="Move Column Silently To Workspace 3" { move-column-to-workspace focus=false 3; }
    Mod+Ctrl+Alt+4 hotkey-overlay-title="Move Column Silently To Workspace 4" { move-column-to-workspace focus=false 4; }
    Mod+Ctrl+Alt+5 hotkey-overlay-title="Move Column Silently To Workspace 5" { move-column-to-workspace focus=false 5; }
    Mod+Ctrl+Alt+6 hotkey-overlay-title="Move Column Silently To Workspace 6" { move-column-to-workspace focus=false 6; }
    Mod+Ctrl+Alt+7 hotkey-overlay-title="Move Column Silently To Workspace 7" { move-column-to-workspace focus=false 7; }
    Mod+Ctrl+Alt+8 hotkey-overlay-title="Move Column Silently To Workspace 8" { move-column-to-workspace focus=false 8; }
    Mod+Ctrl+Alt+9 hotkey-overlay-title="Move Column Silently To Workspace 9" { move-column-to-workspace focus=false 9; }

    // #"Monitors"
    Mod+Shift+Left hotkey-overlay-title="Focus Monitor Left" { focus-monitor-left; }
    Mod+Shift+Right hotkey-overlay-title="Focus Monitor Right" { focus-monitor-right; }
    Mod+Shift+Ctrl+Left hotkey-overlay-title="Move Column To Monitor Left" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right hotkey-overlay-title="Move Column To Monitor Right" { move-column-to-monitor-right; }

    // #"Window Grouping"
    Mod+BracketLeft hotkey-overlay-title="Group/Ungroup Left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Group/Ungroup Right" { consume-or-expel-window-right; }
    Mod+Comma hotkey-overlay-title="Group Window From Right" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="Ungroup Bottom Window" { expel-window-from-column; }

    // #"Resize Windows"
    Mod+R hotkey-overlay-title="Next Column Width" { switch-preset-column-width; }
    Mod+Ctrl+R hotkey-overlay-title="Next Window Height" { switch-preset-window-height; }

    // #"Session"
    Mod+Ctrl+Escape allow-inhibiting=false hotkey-overlay-title="Toggle App Shortcut Control" { toggle-keyboard-shortcuts-inhibit; }
    Mod+L hotkey-overlay-title="Lock Screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Open Power Menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
}

gestures {
    hot-corners {
        off
    }
}

include "noctalia.kdl"
