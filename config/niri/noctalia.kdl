layout {

    focus-ring {
        active-color   "#b7b7b7"
        inactive-color "#232323"
        urgent-color   "#dddddd"
    }

    border {
        active-color   "#b7b7b7"
        inactive-color "#232323"
        urgent-color   "#dddddd"
    }


    tab-indicator {
        active-color   "#b7b7b7"
        inactive-color "#6c5050"
        urgent-color   "#dddddd"
    }

    insert-hint {
        color "#b7b7b780"
    }
}

recent-windows {
    highlight {
        active-color "#b7b7b7"
        urgent-color "#dddddd"
    }
}
