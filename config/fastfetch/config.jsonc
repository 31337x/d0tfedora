{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "->   ",
        "color": {
            "separator": "1"
        },
        "key": {
            "type": "both",
            "paddingLeft": 4
        }
    },
    "modules": [
        {
            "key": "OS           ",
            "keyColor": "red",
            "type": "os",
            "format": "{name} {version-id}"
        },
        {
            "key": "Machine      ",
            "keyColor": "green",
            "type": "host"
        },
        {
            "type": "command",
            "key": "Hostname     ",
            "keyColor": "cyan",
            "keyIcon": "󰒋",
            "text": "printf \"%s@%s\" \"$(id -un)\" \"$(hostname -s)\""
        },
        {
            "key": "Kernel       ",
            "keyColor": "magenta",
            "type": "command",
            "keyIcon": "",
            "text": "printf 'Linux %s' \"$(uname -r | sed 's/\\.fc[0-9]*.*$//')\""
        },
        {
            "key": "Uptime       ",
            "keyColor": "red",
            "type": "uptime"
        },
        {
            "type": "packages",
            "key": "Packages     ",
            "keyColor": "green"
        },
        {
            "key": "Resolution   ",
            "keyColor": "yellow",
            "type": "display",
            "compactType": "original-with-refresh-rate"
        },
        {
            "key": "WM           ",
            "keyColor": "blue",
            "type": "wm",
            "format": "{pretty-name}{?version} {version}{?}"
        },
        {
            "key": "DE           ",
            "keyColor": "green",
            "type": "de"
        },
        {
            "key": "Shell        ",
            "keyColor": "cyan",
            "type": "shell"
        },
        {
            "key": "Terminal     ",
            "keyColor": "red",
            "type": "terminal"
        },
        {
            "key": "CPU          ",
            "keyColor": "yellow",
            "type": "command",
            "keyIcon": "",
            "text": "fastfetch --structure cpu --format json | python3 -c 'import json,re,sys; c=json.load(sys.stdin)[0]['\"'\"'result'\"'\"']; n=re.sub(r'\"'\"'^.*?\\b(i[3579]-)'\"'\"',r'\"'\"'\\1'\"'\"',c['\"'\"'cpu'\"'\"']); cores='\"'\"'+'\"'\"'.join(str(t['\"'\"'count'\"'\"']) for t in sorted(c['\"'\"'coreTypes'\"'\"'],key=lambda t:t['\"'\"'freq'\"'\"'],reverse=True) if t['\"'\"'count'\"'\"']); print(n+'\"'\"' ('\"'\"'+cores+'\"'\"') @ '\"'\"'+format(c['\"'\"'frequency'\"'\"']['\"'\"'max'\"'\"']/1000,'\"'\"'.2f'\"'\"')+'\"'\"' GHz'\"'\"')'"
        },
        {
            "key": "GPU          ",
            "keyColor": "blue",
            "type": "gpu",
            "format": "{vendor} {name}{?frequency} @ {frequency}{?}"
        },
        {
            "key": "Memory       ",
            "keyColor": "magenta",
            "type": "memory",
            "format": "{used} / {total}"
        },
        {
            "key": "Local IP     ",
            "keyColor": "red",
            "type": "localip",
            "compact": true
        },
        {
            "key": "Public IP    ",
            "keyColor": "cyan",
            "type": "publicip",
            "timeout": 1000
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 34,
            "symbol": "circle"
        }
    ]
}
